# ---------------------------------------------------------------------------
# LLM provider — who does the thinking
# ---------------------------------------------------------------------------
# "claude" (production, recommended) or "ollama" (free, local dev).
# "anthropic" is accepted as an alias for "claude".
LLM_PROVIDER=anthropic

# --- Claude (required if LLM_PROVIDER=claude) ---
# Get a key at https://platform.anthropic.com
ANTHROPIC_API_KEY=your-key-here
# claude-opus-5 is the default. claude-sonnet-5 is a cheaper option that
# handles this pipeline well — a full run makes 1 + N + (2 x rounds) calls.
ANTHROPIC_MODEL=claude-opus-5

# --- Ollama (required if LLM_PROVIDER=ollama) ---
# Local dev only — make sure "ollama serve" is running and the model is pulled.
# Prefer a model WITHOUT a thinking/reasoning mode: reasoning tokens leak into
# schema-constrained JSON output. gemma3:12b is the tested default.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# ---------------------------------------------------------------------------
# Search provider — where the evidence comes from
# ---------------------------------------------------------------------------
# "anthropic" (Claude's server-side web_search tool) or "tavily" (free tier).
# Research agents ALWAYS search. There is no answer-from-model-knowledge path.
SEARCH_PROVIDER=anthropic

# --- Tavily (required if SEARCH_PROVIDER=tavily) ---
# Free tier: 1,000 credits/month, no credit card. https://app.tavily.com
TAVILY_API_KEY=tvly-your-key-here
# "basic" (1 credit/search) or "advanced" (2 credits, deeper extraction).
TAVILY_SEARCH_DEPTH=basic
# Optional. Point at a compatible gateway/proxy instead of Tavily directly.
# TAVILY_BASE_URL=https://api.tavily.com

# ---------------------------------------------------------------------------
# Pipeline tuning
# ---------------------------------------------------------------------------
# How many Stage 2 research agents run at once. The rest queue and backfill.
MAX_CONCURRENT_RESEARCH_AGENTS=5
# Search rounds each research agent may run before it must stop.
MAX_RESEARCH_ROUNDS_PER_QUESTION=3
# Report -> critique -> revise rounds before escalating to the user.
MAX_REPORT_REVISION_ROUNDS=3
